# Real certificates and keys must NEVER enter the repository.
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.der
*.jks
*.keystore

# Secrets and local config
.env
.env.*
!.env.example
secrets/
local/

# Real signed avals / personal data used during the PoC
poc/private/
*.signed.xml

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Public CA certificates of the curated trust list are allowed (never put personal certificates there).
!poc/trust/**/*.crt
!trust/**/*.crt

*.egg-info/

# Private working documents (outreach drafts, candidacy-specific material). Never replicated to GitHub.
private-docs
private-docs/
